///|
test "浏览器桥接返回营业状态与下次变化" {
  assert_eq(
    @bridge.evaluate("Mo-Fr 09:00-18:00", "2026-11-02T10:00", "", ""),
    "营业中\n下次状态变化：2026-11-02T18:00",
  )
}

///|
test "浏览器桥接将注入的 PH 日期用于求值" {
  assert_eq(
    @bridge.evaluate(
      "Mo-Fr 09:00-18:00; PH off", "2026-11-02T10:00", "2026-11-02", "",
    ),
    "已关闭\n下次状态变化：2026-11-03T09:00",
  )
}

///|
test "浏览器桥接为非法表达式保留错误位置" {
  assert_eq(
    @bridge.evaluate("Mo-Fr sunrise-sunset", "2026-11-02T10:00", "", ""),
    "表达式错误（位置 6）：规则中存在无法识别的词",
  )
}
